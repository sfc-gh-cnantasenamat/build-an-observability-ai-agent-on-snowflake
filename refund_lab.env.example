# Copy to .refund_lab.env (gitignored), fill in, then: source .refund_lab.env
export REFUND_LAB_CONNECTION="my_connection"          # name in ~/.snowflake/connections.toml
export REFUND_LAB_ACCOUNT="MYORG-MY_ACCOUNT"           # SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT();
export REFUND_LAB_WAREHOUSE="COMPUTE_WH"
export REFUND_LAB_LANGFUSE_HOST=""                     # set after deploying Langfuse (SHOW ENDPOINTS)
export REFUND_LAB_ADMIN_EMAIL="you@example.com"        # Langfuse UI login, used by langfuse_spcs/build_spec.py
